# Server
PORT=8080
DEV_MODE=development

# MongoDB (required for auth & reviews)
MONGO_URI=your_mongodb_connection_string

# JWT (required for auth)
JWT_ACCESS_SECRET=your_jwt_secret
JWT_ACCESS_EXPIREIN=15min
JWT_REFRESH_TOKEN=your_refresh_secret
JWT_REFRESH_EXIPREIN=15day

# AI - OpenRouter (FREE tier available) - REQUIRED for chatbot
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-r1:free

# Google Places (optional - for ratings on nearby clinics/pharmacies)
GOOGLE_PLACES_API_KEY=your_google_places_key

# OpenWeatherMap (optional - for environment-aware health tips)
OPENWEATHER_API_KEY=your_openweather_key
